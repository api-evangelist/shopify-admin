{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shopify Admin REST Collections API",
    "version": "2024-10"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Shopify-Access-Token",
      "value": "{{X-Shopify-Access-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Collects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{store_name}.myshopify.com/admin/api/2024-10/collects.json",
            "params": [
              {
                "name": "collection_id",
                "value": "",
                "type": "query",
                "description": "Filter by collection ID"
              },
              {
                "name": "product_id",
                "value": "",
                "type": "query",
                "description": "Filter by product ID"
              }
            ]
          },
          "docs": "Retrieves a list of collects (product-collection relationships)."
        },
        {
          "info": {
            "name": "List Custom Collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{store_name}.myshopify.com/admin/api/2024-10/custom_collections.json",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of results to show"
              }
            ]
          },
          "docs": "Retrieves a list of custom collections."
        }
      ]
    }
  ],
  "bundled": true
}